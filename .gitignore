# Local ADB / CI artifact downloads
platform-tools/
build-artifacts/
*.apk
*.ipa

# Gradle / Android build outputs (keep android/app/debug.keystore tracked for persistent ADB updates)
.gradle/
android/.gradle/
android/build/
android/app/build/
android/local.properties

# Xcode / macOS / local IDE
Frameworks/
DerivedData/
build/
.DS_Store
*.xcuserstate

# Soulseek Bridge runtime files (keep scripts tracked)
soulseek-bridge/bin/
soulseek-bridge/downloads/
soulseek-bridge/incomplete/
soulseek-bridge/logs/
soulseek-bridge/.env
soulseek-bridge/.bridge_state.json
soulseek-bridge/slskd.yml
soulseek-bridge/*.db
soulseek-bridge/__pycache__/
